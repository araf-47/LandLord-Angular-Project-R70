<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp"
            android:text="Operations"
            android:textAppearance="?attr/textAppearanceTitleSmall"
            android:textColor="?attr/colorPrimary" />

        <TextView
            android:id="@+id/more_marketplace"
            style="@style/MoreRow"
            android:drawableStart="@drawable/ic_more_marketplace"
            android:text="Marketplace" />

        <TextView
            android:id="@+id/more_maintenance"
            style="@style/MoreRow"
            android:drawableStart="@drawable/ic_more_maintenance"
            android:text="Maintenance" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp"
            android:text="Finance"
            android:textAppearance="?attr/textAppearanceTitleSmall"
            android:textColor="?attr/colorPrimary" />

        <TextView
            android:id="@+id/more_expenses"
            style="@style/MoreRow"
            android:drawableStart="@drawable/ic_more_expenses"
            android:text="Expenses" />

        <TextView
            android:id="@+id/more_ledger"
            style="@style/MoreRow"
            android:drawableStart="@drawable/ic_more_ledger"
            android:text="Ledger" />

        <TextView
            android:id="@+id/more_payment_receipts"
            style="@style/MoreRow"
            android:drawableStart="@drawable/ic_more_receipts"
            android:text="Payment Receipts" />

        <TextView
            android:id="@+id/more_reports"
            style="@style/MoreRow"
            android:drawableStart="@drawable/ic_more_reports"
            android:text="Reports" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp"
            android:text="Communication"
            android:textAppearance="?attr/textAppearanceTitleSmall"
            android:textColor="?attr/colorPrimary" />

        <TextView
            android:id="@+id/more_messages"
            style="@style/MoreRow"
            android:drawableStart="@drawable/ic_more_messages"
            android:text="Messages" />

        <TextView
            android:id="@+id/more_notifications"
            style="@style/MoreRow"
            android:drawableStart="@drawable/ic_more_notifications"
            android:text="Notifications" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp"
            android:text="Intelligence"
            android:textAppearance="?attr/textAppearanceTitleSmall"
            android:textColor="?attr/colorPrimary" />

        <TextView
            android:id="@+id/more_insights"
            style="@style/MoreRow"
            android:drawableStart="@drawable/ic_more_insights"
            android:text="AI Insights" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp"
            android:text="Account"
            android:textAppearance="?attr/textAppearanceTitleSmall"
            android:textColor="?attr/colorPrimary" />

        <TextView
            android:id="@+id/more_settings"
            style="@style/MoreRow"
            android:drawableStart="@drawable/ic_more_settings"
            android:text="Settings" />

    </LinearLayout>
</ScrollView>
