<?xml version="1.0" encoding="utf-8"?>
<MotionScene xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:motion="http://schemas.android.com/apk/res-auto">

    <Transition
        motion:constraintSetEnd="@+id/collapsed"
        motion:constraintSetStart="@+id/expanded"
        motion:duration="200"
        motion:motionInterpolator="linear">
        <OnSwipe
            motion:dragDirection="dragUp"
            motion:touchAnchorId="@+id/units_list"
            motion:touchAnchorSide="top" />
    </Transition>

    <ConstraintSet android:id="@+id/expanded">
        <Constraint android:id="@+id/detail_header_card" android:layout_height="120dp">
            <CustomAttribute
                motion:attributeName="CardElevation"
                motion:customFloatValue="2" />
        </Constraint>
        <Constraint android:id="@+id/detail_property_name">
            <CustomAttribute
                motion:attributeName="TextSize"
                motion:customFloatValue="24" />
        </Constraint>
    </ConstraintSet>

    <ConstraintSet android:id="@+id/collapsed">
        <Constraint android:id="@+id/detail_header_card" android:layout_height="56dp">
            <CustomAttribute
                motion:attributeName="CardElevation"
                motion:customFloatValue="6" />
        </Constraint>
        <Constraint android:id="@+id/detail_property_name">
            <CustomAttribute
                motion:attributeName="TextSize"
                motion:customFloatValue="16" />
        </Constraint>
    </ConstraintSet>

</MotionScene>
